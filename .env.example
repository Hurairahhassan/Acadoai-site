# EmailJS (client-side)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Calendly
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/acadoai/acadoa-demo

# Header counters (Stats section)
NEXT_PUBLIC_STATS_1_VALUE=500+
NEXT_PUBLIC_STATS_2_VALUE=2M+
NEXT_PUBLIC_STATS_3_VALUE=98%
NEXT_PUBLIC_STATS_4_VALUE=40+
NEXT_PUBLIC_STATS_5_VALUE=99.9%

# Site / SEO
NEXT_PUBLIC_SITE_URL=https://acadoai.com
# Comma-separated social profile URLs (used in footer + Organization schema)
NEXT_PUBLIC_SOCIAL_URLS=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Set to true only once the NEXT_PUBLIC_STATS_* numbers above are real
NEXT_PUBLIC_SHOW_STATS=false
